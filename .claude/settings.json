{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(python scripts/status.py)",
      "Bash(python scripts/run_tests.py:*)",
      "Bash(.venv/Scripts/python.exe scripts/status.py)",
      "Bash(.venv/Scripts/python.exe scripts/run_tests.py:*)",
      "Bash(powershell -NoProfile -Command Get-ScheduledTask*)",
      "Bash(powershell -NoProfile -Command Get-Content*)"
    ],
    "deny": [
      "Bash(shutdown:*)",
      "Bash(Stop-ScheduledTask:*)",
      "Bash(Unregister-ScheduledTask:*)",
      "Bash(powershell*Stop-ScheduledTask*)",
      "Bash(powershell*Unregister-ScheduledTask*)",
      "Bash(powershell*Stop-Process*)",
      "Bash(rm -rf data/*)",
      "Bash(Remove-Item*data*)",
      "Read(./.env)",
      "Read(./data/tracker.db)"
    ]
  }
}
